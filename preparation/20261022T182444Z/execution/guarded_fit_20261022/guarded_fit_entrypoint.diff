+def require_finite(name, value):
+    """Stop a fit when a loss, score, or coefficient is non-finite."""
+    if torch.is_tensor(value):
+        finite = bool(torch.isfinite(value).all().item())
+    else:
+        finite = bool(np.isfinite(np.asarray(value, dtype=float)).all())
+    if not finite:
+        raise FloatingPointError(f"Non-finite {name}")
+
+def validate_metric_fields(name, metrics, numeric_fields, undefined_fields=()):
+    """Check numeric metrics and label undefined descriptive statistics."""
+    result = dict(metrics)
+    for field in numeric_fields:
+        value = result[field]
+        if not np.isfinite(float(value)):
+            if field in undefined_fields:
+                result[field] = "undefined"
+            else:
+                raise FloatingPointError(f"Non-finite {name} field: {field}")
+    return result
+
 
